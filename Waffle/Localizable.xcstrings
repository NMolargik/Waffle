    "Also unlocks Waffle on iPad and iPhone Duo: bigger grids, a third and fourth pane, Desk Mode": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También desbloquea Waffle en el iPad y el iPhone Duo: cuadrículas más grandes, un tercer y cuarto panel y el modo escritorio"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloque aussi Waffle sur iPad et iPhone Duo : des grilles plus grandes, un troisième et un quatrième volet, le mode bureau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadとiPhone Duo版Waffleも解放します：より大きなグリッド、3つ目と4つ目のペイン、デスクモード"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
    "Also unlocks Waffle on iPad: bigger grids, pop-out, fullscreen and rearranging": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También desbloquea Waffle en el iPad: cuadrículas más grandes, ventanas independientes, pantalla completa y reordenación"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloque aussi Waffle sur iPad : des grilles plus grandes, la fenêtre indépendante, le plein écran et la réorganisation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad版Waffleも解放します：より大きなグリッド、ポップアウト、全画面表示、並べ替え"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
    "Always Block": {
      "extractionState": "manual",
      "localizations": {
        "es": {
