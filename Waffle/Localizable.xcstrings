    "Always free: two panes, one saved layout, auto-refresh and content blocking": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre gratis: dos paneles, un diseño guardado, actualización automática y bloqueo de contenido"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours gratuit : deux volets, une disposition enregistrée, l’actualisation automatique et le blocage de contenu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも無料：2つのペイン、保存できるレイアウト1件、自動更新、コンテンツブロック"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
    "Applies to every cell. Override it for a single cell or site from the cell's context menu. Sites listed here are never blocked.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las celdas. Puedes cambiarlo para una celda o un sitio desde el menú contextual de la celda. Los sitios de esta lista nunca se bloquean."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à toutes les cellules. Modifiez-le pour une cellule ou un site depuis le menu contextuel de la cellule. Les sites listés ici ne sont jamais bloqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのセルに適用されます。セルのコンテキストメニューから、セルまたはサイトごとに変更できます。ここに表示されたサイトはブロックされません。"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
    "Applies to every pane. To change it for one pane or site, open ••• then This Page then Content Blocking. Sites listed here are never blocked.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todos los paneles. Para cambiarlo en un panel o sitio, abre ••• y luego Esta página y Bloqueo de contenido. Los sitios de esta lista nunca se bloquean."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à tous les volets. Pour le changer pour un volet ou un site, ouvrez ••• puis Cette page puis Blocage de contenu. Les sites de cette liste ne sont jamais bloqués."
          }
        },
        "ja": {
          "stringUnit": {
