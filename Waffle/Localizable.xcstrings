    "A layout remembers your open panes: the page in each one and how much room each has": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un diseño recuerda tus paneles abiertos: la página de cada uno y el espacio que ocupa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une disposition retient vos volets ouverts : la page de chacun et la place qu’il occupe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトは、開いているペイン、それぞれのページ、各ペインの広さを記憶します"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
    "A one-time purchase. No subscription.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra única. Sin suscripción."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat unique. Aucun abonnement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りです。サブスクリプションはありません。"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
    "A preset saves your whole grid — size and every page in it": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preajuste guarda toda tu cuadrícula: el tamaño y cada una de sus páginas"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un préréglage enregistre toute votre grille — sa taille et chacune de ses pages"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットはグリッド全体（サイズとすべてのページ）を保存します"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
    "A third and fourth pane on this display": {
      "extractionState": "manual",
