    "Adjust to resize panes. Double tap to reset to an even split": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta para cambiar el tamaño de los paneles. Toca dos veces para volver a una división equilibrada"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez pour redimensionner les volets. Touchez deux fois pour rétablir une division égale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整してペインのサイズを変更します。ダブルタップで均等な分割に戻します"
          }
        }
      },
      "shouldGenerateSymbol": false
    },
